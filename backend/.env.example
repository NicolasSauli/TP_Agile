# TP_Agile Auth Service Environment Variables
# Copy this file to .env and update the values

# Application settings
APP_NAME="TP_Agile Auth Service"
APP_VERSION="1.0.0"
DEBUG=True

# JWT Configuration
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY="your-very-secure-secret-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# SQLite is file-based, so no connection string needed
# For future migration to PostgreSQL or MySQL:
# DATABASE_URL="postgresql://user:password@localhost/dbname"

# CORS Settings (comma-separated list of origins)
# Example: CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"
CORS_ORIGINS="*"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Logging Configuration
LOG_LEVEL="INFO"
